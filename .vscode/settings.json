{
	"search.exclude": {
		"export/**/*.*": true
	},
	"[haxe]": {
		"editor.formatOnSave": false,
		"editor.formatOnPaste": false,
		"editor.codeActionsOnSave": {
			"source.sortImports": "explicit"
		}
	},
	"haxe.enableExtendedIndentation": true,
	"githubPullRequests.ignoredPullRequestBranches": [
		"alpha"
	]
}
